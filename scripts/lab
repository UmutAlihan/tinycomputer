#!/usr/bin/env bash
# Build the module, attest it, and run the tinydesktop lab against this desktop.
#
#   scripts/lab list
#   scripts/lab run mail-compose --headed
#   scripts/lab eval all --modes flow,goal --trials 3
#
# The module is built in release mode into target/lab/ with a modules.toml
# beside it, so TinyBus attests it exactly as a packaged release would be.
# Variables from .env are exported when the file exists; nothing is printed.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

case "$(uname -s)" in
  Darwin) library="libtinydesktop.dylib" ;;
  Linux) library="libtinydesktop.so" ;;
  *) echo "the lab runs on macOS or Linux" >&2; exit 1 ;;
esac

# `list`, `guide`, and `report` never load the module.
case "${1:-help}" in
  list|guide|report|help|-h|--help) ;;
  *)
    cargo build --release -p tinydesktop --lib >&2
    mkdir -p target/lab
    cp "target/release/${library}" "target/lab/${library}"
    hash="$(shasum -a 256 "target/lab/${library}" | awk '{print $1}')"
    printf '"%s" = "%s"\n' "$library" "$hash" > target/lab/modules.toml
    ;;
esac

export TINYDESKTOP_MODULE="${TINYDESKTOP_MODULE:-$root/target/lab/${library}}"
exec cargo run --quiet -p tinydesktop-examples --bin lab -- "$@"
