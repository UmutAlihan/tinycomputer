#!/usr/bin/env bash
# Build the module, attest it, and run the tinycomputer lab against this desktop.
#
#   scripts/lab list
#   scripts/lab run mail-compose --headed
#   scripts/lab eval all --modes flow,goal --trials 3
#
# The module is built in release mode into target/lab/ with a modules.toml
# beside it, so TinyBus attests it exactly as a packaged release would be.
# Variables from .env are exported when the file exists; nothing is printed.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

case "$(uname -s)" in
  Darwin) library="libtinycomputer.dylib" ;;
  Linux) library="libtinycomputer.so" ;;
  *) echo "the lab runs on macOS or Linux" >&2; exit 1 ;;
esac

# `list`, `guide`, and `report` never load the module.
case "${1:-help}" in
  list|guide|report|help|-h|--help) ;;
  *)
    cargo build --release -p tinycomputer --lib >&2
    mkdir -p target/lab
    cp "target/release/${library}" "target/lab/${library}"
    if [[ "$(uname -s)" == "Darwin" ]]; then
      # The engine's clipboard (and so the paste fallback for rich-text
      # fields) runs through a helper it only trusts beside the module.
      cargo build --release -p agent-desktop-macos --bin agent-desktop-macos-helper >&2
      install -m 755 target/release/agent-desktop-macos-helper target/lab/agent-desktop-macos-helper
    fi
    hash="$(shasum -a 256 "target/lab/${library}" | awk '{print $1}')"
    printf '"%s" = "%s"\n' "$library" "$hash" > target/lab/modules.toml
    ;;
esac

export TINYCOMPUTER_MODULE="${TINYCOMPUTER_MODULE:-$root/target/lab/${library}}"
exec cargo run --quiet -p tinycomputer-examples --bin lab -- "$@"
