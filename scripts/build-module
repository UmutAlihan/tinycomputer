#!/usr/bin/env bash
# Build the tinycomputer module in release mode and attest it, the way a
# packaged release is: the library is copied into <target>/lab/ with a
# modules.toml beside it naming its SHA-256, so the TinyBus loader will load
# it and deliver confidential calls (StartTask, RunFlow) to it.
#
#   scripts/build-module            # prints the module path on stdout
#   TINYCOMPUTER_MODULE="$(scripts/build-module)" cargo run -p tinycomputer-examples --bin task_live
#
# <target> is $CARGO_TARGET_DIR when set (the Docker lab sets it), else target/.
# TINYCOMPUTER_MODULE_DIR installs the module somewhere else instead of
# <target>/lab: the loader refuses a module when any directory above it is
# writable by, or owned by, another user, which rules out the Docker lab's
# bind mount and volumes, so the Docker runners install into $HOME.
# Every runner that drives the module over the bus — scripts/lab, tasks/run,
# fixtures/run — builds it through here.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
target="${CARGO_TARGET_DIR:-$root/target}"
dir="${TINYCOMPUTER_MODULE_DIR:-$target/lab}"

case "$(uname -s)" in
  Darwin) library="libtinycomputer.dylib" ;;
  Linux) library="libtinycomputer.so" ;;
  *) echo "build-module runs on macOS or Linux" >&2; exit 1 ;;
esac

cargo build --locked --release -p tinycomputer --lib >&2
mkdir -p "$dir"
# The TinyBus loader refuses a module whose directory or file another user
# could write, so an inherited group- or world-writable mode (the Docker
# lab's volumes are) is stripped here rather than left to fail the load.
chmod 755 "$dir"
install -m 644 "$target/release/${library}" "$dir/${library}"
if [[ "$(uname -s)" == "Darwin" ]]; then
  # The engine's clipboard (and so the paste fallback for rich-text
  # fields) runs through a helper it only trusts beside the module.
  cargo build --locked --release -p agent-desktop-macos --bin agent-desktop-macos-helper >&2
  install -m 755 "$target/release/agent-desktop-macos-helper" "$dir/agent-desktop-macos-helper"
fi
if command -v sha256sum >/dev/null 2>&1; then
  hash="$(sha256sum "$dir/${library}" | awk '{print $1}')"
else
  hash="$(shasum -a 256 "$dir/${library}" | awk '{print $1}')"
fi
printf '"%s" = "%s"\n' "$library" "$hash" > "$dir/modules.toml"
chmod 644 "$dir/modules.toml"
# The loader checks every directory above the module too, so refuse here —
# naming the culprit — rather than print a path it will not load from.
ancestor="$(cd "$dir" && pwd -P)"
while :; do
  # GNU `%a` and BSD `%p` both end in the permission bits, sticky included.
  raw="$(stat -c '%a' "$ancestor" 2>/dev/null || stat -f '%p' "$ancestor")"
  mode=$(( 8#$raw & 8#7777 ))
  owner="$(stat -c '%u' "$ancestor" 2>/dev/null || stat -f '%u' "$ancestor")"
  if (( (mode & 8#022) != 0 && (mode & 8#1000) == 0 )); then
    echo "build-module: $ancestor is writable by other users, so the loader will refuse" >&2
    echo "  a module under it; set TINYCOMPUTER_MODULE_DIR to a directory whose every" >&2
    echo "  parent is writable only by you (for example \$HOME/.local/lib/tinycomputer)" >&2
    exit 1
  fi
  if [[ "$owner" != "$(id -u)" && "$owner" != 0 ]]; then
    echo "build-module: $ancestor is owned by another user, so the loader will refuse" >&2
    echo "  a module under it; set TINYCOMPUTER_MODULE_DIR elsewhere" >&2
    exit 1
  fi
  [[ "$ancestor" == / ]] && break
  ancestor="$(dirname "$ancestor")"
done
echo "$dir/${library}"
