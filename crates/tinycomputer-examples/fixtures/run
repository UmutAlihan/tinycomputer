#!/usr/bin/env bash
# Serves the travel fixture and runs one fixture example against it, inside
# the Docker lab: scripts/docker-lab -- crates/tinycomputer-examples/fixtures/run <bin>
set -euo pipefail
bin="${1:?usage: fixtures/run <browser_fixture|task_fixture>}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TINYCOMPUTER_BROWSER_EXECUTABLE="${TINYCOMPUTER_BROWSER_EXECUTABLE:-$(ls -d /ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | head -1)}"
export TINYCOMPUTER_BROWSER_EXECUTABLE
(cd "$here/travel" && exec python3 -m http.server 8765 >/dev/null 2>&1) &
server=$!
trap 'kill "$server" 2>/dev/null' EXIT
if [ "$bin" = task_fixture ]; then
  # task_fixture drives the built module over the bus, as a host would.
  TINYCOMPUTER_MODULE="${TINYCOMPUTER_MODULE:-$("$here/../../../scripts/build-module")}"
  export TINYCOMPUTER_MODULE
fi
cargo build -q -p tinycomputer-examples --bin "$bin"
cargo run -q -p tinycomputer-examples --bin "$bin"
