#!/usr/bin/env bash
# Serves the travel fixture and runs one fixture example against it, inside
# the Docker lab: scripts/docker-lab -- crates/tinydesktop-examples/fixtures/run <bin>
set -euo pipefail
bin="${1:?usage: fixtures/run <browser_fixture|task_fixture>}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TINYDESKTOP_BROWSER_EXECUTABLE="${TINYDESKTOP_BROWSER_EXECUTABLE:-$(ls -d /ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | head -1)}"
export TINYDESKTOP_BROWSER_EXECUTABLE
(cd "$here/travel" && exec python3 -m http.server 8765 >/dev/null 2>&1) &
server=$!
trap 'kill "$server" 2>/dev/null' EXIT
cargo build -q -p tinydesktop-examples --bin "$bin"
cargo run -q -p tinydesktop-examples --bin "$bin"
